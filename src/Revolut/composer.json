{
    "name": "techork/payment-service-revolut",
    "description": "Revolut Business (virtual card issuing) gateway implementation for payment services",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:andreapalladiokiv/payment-service-common.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:andreapalladiokiv/payment-service-gateway.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0",
        "moneyphp/money": "^4.0",
        "omnipay/common": "^3.5",
        "ramsey/uuid": "^4.0",
        "techork/payment-service-common": "@dev",
        "techork/payment-service-gateway": "@dev"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^2.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0 || ^4.0",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "bin": [
        "bin/revolut-obtain-refresh-token.php"
    ],
    "autoload": {
        "psr-4": {
            "Techork\\PaymentService\\Revolut\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Techork\\PaymentService\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "gateway": "Techork\\PaymentService\\Revolut\\RevolutGateway"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
